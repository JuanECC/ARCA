rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES DE SEGURIDAD
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid ==
          'lJ9W2QteobbETqMoPBonAFfzMgh1';
    }

    function isWaterOperator() {
      return signedIn() && (
        isAdmin()
        || (
          request.auth.uid ==
            'WePWGhGitzWeggBe76Z8Av4o3yH3'
          && get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.role == 'water-operator'
        )
      );
    }

    function isCivilProtection() {
      return signedIn()
        && request.auth.uid ==
          '0MgDjIllJTWIgLPyKCjA7EQNBSw1'
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.role == 'civil-protection';
    }

    function isMaintenance() {
      return signedIn()
        && request.auth.uid ==
          'wDeg2YJdXjdyRkTN4XSnvjv18iB3'
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.role == 'maintenance-crew';
    }

    function validPoint(p) {
      return p is map
        && p.keys().hasOnly(['lat', 'lng'])
        && p.keys().hasAll(['lat', 'lng'])
        && p.lat is number
        && p.lat >= -90
        && p.lat <= 90
        && p.lng is number
        && p.lng >= -180
        && p.lng <= 180;
    }

    function validSectorId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 100
        && exists(
          /databases/$(database)/documents/sectors/$(id)
        );
    }

    // Vincula un aviso a un riesgo real del departamento de PC.
    // getAfter permite validar cambios del mismo lote (cierre / retiro).
    function linkedPcReport(reportId, notice) {
      let report = getAfter(
        /databases/$(database)/documents/systemReports/$(reportId)
      ).data;
      return report.source == 'proteccion-civil'
        && report.status == 'publicado'
        && report.get('createdBy', request.auth.uid) == request.auth.uid
        && report.sectorId == notice.sectorId
        && report.alert is map
        && report.alert.title == notice.title
        && report.alert.message == notice.message;
    }

    // ==========================================
    // VALIDACIÓN DE CUENTAS EXISTENTES
    // ==========================================

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'authEmail',
          'nombre',
          'usuario',
          'role',
          'tipo',
          'creadoEn',
          'operadorUid'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'authEmail',
          'nombre',
          'usuario',
          'role',
          'tipo',
          'creadoEn'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches(
          '[^ @]+@[^ @]+[.][^ @]+'
        )
        && request.resource.data.authEmail is string
        && request.resource.data.usuario is string
        && request.resource.data.usuario.size() >= 2
        && request.resource.data.usuario.size() <= 64
        && request.resource.data.usuario.matches(
          '[a-z0-9]+(-[a-z0-9]+)*'
        )
        && request.resource.data.authEmail ==
          request.resource.data.usuario +
          '@usuarios.arca.example.com'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.creadoEn == request.time
        && (
          request.resource.data.role != 'maintenance-crew'
          || request.resource.data.operadorUid ==
            'WePWGhGitzWeggBe76Z8Av4o3yH3'
        )
        && (
          (
            request.resource.data.role == 'citizen'
            && request.resource.data.tipo == 'comun'
          )
          || (
            request.resource.data.role in [
              'admin',
              'water-operator',
              'civil-protection',
              'maintenance-crew'
            ]
            && request.resource.data.tipo == 'fijo'
          )
        );
    }

    function fixedRole(uid) {
      return (
          uid == 'lJ9W2QteobbETqMoPBonAFfzMgh1'
          && request.resource.data.role == 'admin'
        )
        || (
          uid == 'WePWGhGitzWeggBe76Z8Av4o3yH3'
          && request.resource.data.role == 'water-operator'
        )
        || (
          uid == '0MgDjIllJTWIgLPyKCjA7EQNBSw1'
          && request.resource.data.role == 'civil-protection'
        )
        || (
          uid == 'wDeg2YJdXjdyRkTN4XSnvjv18iB3'
          && request.resource.data.role == 'maintenance-crew'
        );
    }

    // ==========================================
    // CONFIGURACIÓN DEL PERFIL CIUDADANO
    // ==========================================

    function validCitizenSettings() {
      let p = request.resource.data;

      return p.keys().hasOnly([
          'address',
          'zone',
          'zipCode',
          'phone',
          'receiveAlerts',
          'fotoBase64',
          'actualizadoEn',
          'sectorId'
        ])
        && p.keys().hasAll([
          'address',
          'zone',
          'zipCode',
          'phone',
          'receiveAlerts',
          'fotoBase64',
          'actualizadoEn',
          'sectorId'
        ])

        && p.address is string
        && p.address.size() >= 8
        && p.address.size() <= 180

        && p.zone in [
          'centro',
          'norte',
          'sur',
          'poniente',
          'rural'
        ]

        && p.zipCode is string
        && p.zipCode.matches('[0-9]{5}')

        && p.phone is string
        && p.phone.matches('[0-9]{10,13}')

        && p.receiveAlerts is bool

        // Sector de tandeo obligatorio.
        && p.sectorId is string
        && p.sectorId.size() >= 1
        && p.sectorId.size() <= 100

        // Solo sectores existentes y activos.
        && exists(
          /databases/$(database)/documents/sectors/$(p.sectorId)
        )
        && get(
          /databases/$(database)/documents/sectors/$(p.sectorId)
        ).data.active == true

        // Foto de perfil opcional.
        && (
          p.fotoBase64 == null
          || (
            p.fotoBase64 is string
            && p.fotoBase64.size() <= 170000
            && p.fotoBase64.matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
        )

        && p.actualizadoEn == request.time;
    }

    function configuredCitizen(uid) {
      let u = /databases/$(database)/documents/usuarios/$(uid);
      let p = /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil;

      return exists(u)
        && get(u).data.role == 'citizen'
        && exists(p)
        && get(p).data.address is string
        && get(p).data.address.size() >= 8
        && get(p).data.zone in [
          'centro',
          'norte',
          'sur',
          'poniente',
          'rural'
        ]
        && get(p).data.zipCode is string
        && get(p).data.zipCode.matches('[0-9]{5}')
        && get(p).data.phone is string
        && get(p).data.phone.matches('[0-9]{10,13}')
        && get(p).data.sectorId is string
        && get(p).data.sectorId.size() > 0;
    }

    // ==========================================
    // COLECCIÓN: USUARIOS
    // ==========================================

    match /usuarios/{uid} {

      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if signedIn()
        && validProfile(uid)
        && (
          isAdmin()
          || (
            request.auth.uid == uid
            && request.resource.data.authEmail ==
              request.auth.token.email
            && (
              request.resource.data.role == 'citizen'
              || fixedRole(uid)
            )
          )
        );

      allow update, delete: if false;

      // ========================================
      // SUBCOLECCIÓN: CONFIGURACIÓN
      // ========================================

      match /configuracion/{configId} {

        allow get: if signedIn()
          && request.auth.uid == uid
          && configId == 'perfil';

        allow list: if false;

        allow create, update: if signedIn()
          && request.auth.uid == uid
          && configId == 'perfil'
          && get(
            /databases/$(database)/documents/usuarios/$(uid)
          ).data.role == 'citizen'
          && validCitizenSettings();

        allow delete: if false;
      }
    }

    // ==========================================
    // COLECCIÓN: REPORTES CIUDADANOS
    // ==========================================

    match /reportes/{reporteId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && configuredCitizen(request.auth.uid)

        && request.resource.data.keys().hasOnly([
          'usuarioUid',
          'autorNombre',
          'titulo',
          'descripcion',
          'tipo',
          'ubicacion',
          'precisionMetros',
          'fotoBase64',
          'estado',
          'prioridad',
          'creadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'usuarioUid',
          'autorNombre',
          'titulo',
          'descripcion',
          'tipo',
          'ubicacion',
          'precisionMetros',
          'fotoBase64',
          'estado',
          'prioridad',
          'creadoEn'
        ])

        && request.resource.data.usuarioUid ==
          request.auth.uid

        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre ==
          get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.nombre

        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 5
        && request.resource.data.titulo.size() <= 100

        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 10
        && request.resource.data.descripcion.size() <= 1500

        && request.resource.data.tipo in [
          'inundacion',
          'encharcamiento',
          'fuga',
          'drenaje',
          'otro'
        ]

        && validPoint(request.resource.data.ubicacion)

        && request.resource.data.precisionMetros is number
        && request.resource.data.precisionMetros >= 0

        && (
          request.resource.data.fotoBase64 == null
          || (
            request.resource.data.fotoBase64 is string
            && request.resource.data.fotoBase64.size()
              <= 170000
            && request.resource.data.fotoBase64.matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
        )

        && request.resource.data.estado == 'pendiente'
        && request.resource.data.prioridad ==
          'sin-evaluar'
        && request.resource.data.creadoEn == request.time;

      allow update: if (isWaterOperator() || isMaintenance())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'fotoReparacion'])
        && citizenWorkState(reporteId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fotoReparacion'])
          || (isMaintenance()
            && request.resource.data.estado == 'reparado'
            && request.resource.data.fotoReparacion == getAfter(
              /databases/$(database)/documents/systemReports/$('ciudadano_' + reporteId)
            ).data.workDone.photos[0]));
      allow delete: if false;
    }

    // ==========================================
    // COLECCIÓN: SECTORS
    // SECTORES DE ABASTECIMIENTO
    // ==========================================

    match /sectors/{id} {

      // Operaciones consulta todos los sectores.
      // Ciudadanía solo los sectores activos.
      allow get, list: if isWaterOperator()
        || isCivilProtection()
        || isMaintenance()
        || (
          signedIn()
          && resource.data.active == true
        );

      // Crear sectores.
      allow create: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'name',
          'colonias',
          'active',
          'creadoEn',
          'actualizadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'name',
          'colonias',
          'active',
          'creadoEn',
          'actualizadoEn'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100

        && request.resource.data.colonias is string
        && request.resource.data.colonias.size() >= 3
        && request.resource.data.colonias.size() <= 500

        && request.resource.data.active == true

        && request.resource.data.creadoEn == request.time
        && request.resource.data.actualizadoEn ==
          request.time;

      // Editar nombre, colonias o activar/desactivar.
      allow update: if isWaterOperator()

        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'name',
          'colonias',
          'active',
          'actualizadoEn'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100

        && request.resource.data.colonias is string
        && request.resource.data.colonias.size() >= 3
        && request.resource.data.colonias.size() <= 500

        && request.resource.data.active is bool

        && request.resource.data.actualizadoEn ==
          request.time;

      // Los sectores nunca se eliminan.
      allow delete: if false;
    }

    // ==========================================
    // COLECCIÓN: SCHEDULE
    // CALENDARIO DE TANDEO
    // ==========================================

    match /schedule/{id} {

      // Lectura de programación.
      allow read: if isWaterOperator()
        || (
          signedIn()
          && validSectorId(resource.data.sectorId)
          && get(
            /databases/$(database)/documents/sectors/$(resource.data.sectorId)
          ).data.active == true
        );

      // Crear o editar días.
      allow create, update: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'sectorId',
          'fecha',
          'status',
          'from',
          'to',
          'note',
          'actualizadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'sectorId',
          'fecha',
          'status',
          'from',
          'to',
          'note',
          'actualizadoEn'
        ])

        && validSectorId(
          request.resource.data.sectorId
        )

        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches(
          '[0-9]{4}-[0-9]{2}-[0-9]{2}'
        )

        && id ==
          request.resource.data.sectorId + '_' +
          request.resource.data.fecha

        && request.resource.data.status in [
          'continuo',
          'parcial',
          'corte'
        ]

        && request.resource.data.from is string
        && request.resource.data.to is string

        && request.resource.data.note is string
        && request.resource.data.note.size() <= 400

        && request.resource.data.actualizadoEn ==
          request.time;

      // Operaciones puede retirar programación.
      allow delete: if isWaterOperator();
    }

    // ==========================================
    // COLECCIÓN: SYSTEMREPORTS
    // REPORTES DE OPERACIONES Y PROTECCIÓN CIVIL
    // ==========================================

    function citizenWorkState(id) {
      let workId = 'ciudadano_' + id;
      let work = getAfter(/databases/$(database)/documents/systemReports/$(workId)).data;
      return work.source == 'ciudadano'
        && work.citizenReportId == id
        && work.citizenUid == resource.data.usuarioUid
        && (
          (isWaterOperator() && crewWorkStatus(work) == 'asignado'
            && request.resource.data.estado == 'en-revision')
          || (isMaintenance() && crewWorkStatus(work) == 'en-proceso'
            && request.resource.data.estado == 'en-reparacion')
          || (isMaintenance() && work.status == 'terminado'
            && request.resource.data.estado == 'reparado')
          || (isWaterOperator() && work.status == 'resuelto'
            && request.resource.data.estado == 'resuelto')
        );
    }

    function crewWorkStatus(report) {
      return report.status == 'asignado'
        && report.assignment.get('progress', {}).get('state', '') == 'en-proceso'
        ? 'en-proceso' : report.status;
    }

    function validCrewPhoto(photo) {
      return photo is string && photo.size() <= 160000
        && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function validCrewEvidence(work, leader) {
      return work is map && work.keys().hasOnly(['note', 'photos', 'by', 'at'])
        && work.note is string && work.note.size() >= 10 && work.note.size() <= 280
        && work.by == leader && work.at is string
        && work.photos is list && work.photos.size() >= 1 && work.photos.size() <= 3
        && validCrewPhoto(work.photos[0])
        && (work.photos.size() < 2 || validCrewPhoto(work.photos[1]))
        && (work.photos.size() < 3 || validCrewPhoto(work.photos[2]));
    }

    function validDirectCrewAssignment(id, work) {
      let assignment = work.assignment;
      let progress = assignment.progress;
      let citizenPath = /databases/$(database)/documents/reportes/$(work.citizenReportId);
      return work.source == 'ciudadano'
        && id == 'ciudadano_' + work.citizenReportId
        && work.status == 'asignado'
        && validSectorId(work.sectorId)
        && get(citizenPath).data.usuarioUid == work.citizenUid
        && get(citizenPath).data.estado == 'pendiente'
        && getAfter(citizenPath).data.estado == 'en-reparacion'
        && assignment.keys().hasOnly(['crew', 'instructions', 'at', 'progress'])
        && assignment.crew is string && assignment.crew.size() <= 120
        && assignment.instructions == '' && assignment.at is string
        && progress.keys().hasOnly(['state', 'leader', 'member', 'at'])
        && progress.state == 'en-proceso' && progress.at == assignment.at
        && progress.leader == progress.member.name
        && progress.leader is string && progress.leader.size() >= 2 && progress.leader.size() <= 60
        && get(/databases/$(database)/documents/sectorCrews/$(work.sectorId))
          .data.members.hasAny([progress.member]);
    }

    function validDirectCrewReport(work) {
      let citizen = get(/databases/$(database)/documents/reportes/$(work.citizenReportId)).data;
      return work.keys().hasOnly([
        'source', 'citizenReportId', 'citizenUid', 'sectorId', 'type', 'colonia',
        'description', 'position', 'photos', 'reporter', 'status', 'assignment', 'creadoEn'
      ])
        && work.type == citizen.tipo
        && work.colonia == citizen.titulo
        && work.description == citizen.descripcion
        && work.position == citizen.ubicacion && validPoint(work.position)
        && work.photos == (citizen.get('fotoBase64', null) == null ? [] : [citizen.fotoBase64])
        && work.reporter == (citizen.get('autorNombre', '') == '' ? 'Ciudadanía' : citizen.autorNombre)
        && work.creadoEn == request.time;
    }

    match /sectorCrews/{id} {
      allow read: if isMaintenance();
      allow create, update: if isMaintenance() && validSectorId(id)
        && request.resource.data.keys().hasOnly(['sectorId', 'members', 'actualizadoEn'])
        && request.resource.data.sectorId == id
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 30
        && request.resource.data.actualizadoEn == request.time;
    }

    match /workUpdates/{id} {
      function matchesWork() {
        let work = getAfter(/databases/$(database)/documents/systemReports/$(id)).data;
        let update = request.resource.data;
        return work.source in ['ciudadano', 'operaciones']
          && update.keys().hasOnly([
            'reportId', 'sectorId', 'sectorName', 'title', 'position', 'status', 'actualizadoEn'
          ])
          && update.reportId == id && update.sectorId == work.sectorId
          && update.position == work.position && validPoint(update.position)
          && update.sectorName is string && update.sectorName.size() <= 120
          && update.title is string && update.title.size() <= 120
          && update.actualizadoEn == request.time
          && update.status == crewWorkStatus(work)
          && ((isWaterOperator() && update.status in ['asignado', 'resuelto'])
            || (isMaintenance() && update.status in ['en-proceso', 'terminado']));
      }
      allow read: if isMaintenance() || isWaterOperator();
      allow create: if matchesWork();
      allow update: if matchesWork()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'actualizadoEn']);
    }

    match /systemReports/{id} {

      allow get: if isMaintenance() && id.matches('ciudadano_.+')
        && (!exists(/databases/$(database)/documents/systemReports/$(id))
          || resource.data.source == 'ciudadano');
      allow create: if isMaintenance()
        && validDirectCrewAssignment(id, request.resource.data)
        && validDirectCrewReport(request.resource.data);
      allow update: if isMaintenance() && resource.data.status == 'nuevo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignment'])
        && validDirectCrewAssignment(id, request.resource.data);

      allow read: if isWaterOperator()
        || isCivilProtection()
        || (isMaintenance()
          && resource.data.source in ['ciudadano', 'operaciones']
          && resource.data.status in ['asignado', 'terminado', 'resuelto']);

      // Crear reportes institucionales.
      allow create: if (
          isWaterOperator()
          || isCivilProtection()
        )

        && request.resource.data.keys().hasOnly([
          'source',
          'sectorId',
          'type',
          'colonia',
          'description',
          'position',
          'photos',
          'status',
          'reporter',
          'createdBy',
          'citizenUid',
          'citizenReportId',
          'creadoEn',
          'level'
        ])

        && request.resource.data.keys().hasAll([
          'source',
          'sectorId',
          'type',
          'colonia',
          'description',
          'position',
          'photos',
          'status',
          'reporter',
          'creadoEn'
        ])

        && request.resource.data.source in [
          'ciudadano',
          'operaciones',
          'proteccion-civil'
        ]

        && validSectorId(
          request.resource.data.sectorId
        )

        && request.resource.data.type is string

        && request.resource.data.colonia is string
        && request.resource.data.colonia.size() <= 100

        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1500

        && validPoint(
          request.resource.data.position
        )

        // Evidencia obligatoria.
        && request.resource.data.photos is list
        && request.resource.data.photos.size() == 1

        && request.resource.data.photos[0] is string
        && request.resource.data.photos[0].size()
          <= 170000

        && request.resource.data.photos[0].matches(
          'data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+'
        )

        && request.resource.data.reporter is string
        && request.resource.data.reporter.size() <= 200

        && request.resource.data.status == 'nuevo'

        && request.resource.data.creadoEn ==
          request.time

        // Protección Civil solo crea sus reportes.
        && (
          isWaterOperator()
          || (
            isCivilProtection()
            && request.resource.data.source ==
              'proteccion-civil'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.level in [
              'medio', 'alto', 'critico'
            ]
            && request.resource.data.photos[0].matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
        );

      // Operaciones asigna o publica reportes.
      // Cuadrillas terminan trabajos asignados.
      allow update: if (

        (
          isWaterOperator()
          && (
            (
              resource.data.status == 'nuevo'
              && request.resource.data.status in [
                'asignado',
                'publicado'
              ]
            )
            || (
              resource.data.status == 'terminado'
              && request.resource.data.status ==
                'resuelto'
            )
          )

          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'status',
            'assignment',
            'notice'
          ])
        )

        || (

          isMaintenance()
          && resource.data.source in ['ciudadano', 'operaciones']
          && resource.data.status == 'asignado'
          && (
            (request.resource.data.status == 'asignado'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignment'])
              && !('progress' in resource.data.assignment)
              && request.resource.data.assignment.diff(resource.data.assignment)
                .affectedKeys().hasOnly(['progress'])
              && request.resource.data.assignment.progress.keys().hasOnly(['state', 'leader', 'at'])
              && request.resource.data.assignment.progress.state == 'en-proceso'
              && request.resource.data.assignment.progress.leader is string
              && request.resource.data.assignment.progress.leader.size() >= 2
              && request.resource.data.assignment.progress.leader.size() <= 60
              && request.resource.data.assignment.progress.at is string)
            || (request.resource.data.status == 'terminado'
              && resource.data.assignment.progress.state == 'en-proceso'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'workDone'])
              && validCrewEvidence(request.resource.data.workDone, resource.data.assignment.progress.leader))
          )
        )
      );

      // ========================================
      // PROTECCIÓN CIVIL: BORRADORES Y ALERTAS
      // ========================================

      // Solo edita, publica o controla sus propios riesgos.
      allow update: if isCivilProtection()
        && resource.data.source == 'proteccion-civil'
        // La cuenta institucional fija puede gestionar su legado sin
        // createdBy. Si el campo existe, debe coincidir con su UID.
        && resource.data.get('createdBy', request.auth.uid) == request.auth.uid
        && request.resource.data.source == resource.data.source
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.sectorId == resource.data.sectorId
        && (
          // Editar exclusivamente una alerta nueva.
          (
            resource.data.status == 'nuevo'
            && request.resource.data.status == 'nuevo'
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'type', 'level', 'colonia', 'description',
                'position', 'photos', 'reporter'
              ])
            && request.resource.data.level in [
              'medio', 'alto', 'critico'
            ]
            && request.resource.data.description is string
            && request.resource.data.description.size() >= 10
            && request.resource.data.description.size() <= 1500
            && request.resource.data.colonia is string
            && request.resource.data.colonia.size() <= 100
            && validPoint(request.resource.data.position)
            && request.resource.data.photos is list
            && request.resource.data.photos.size() == 1
            && request.resource.data.photos[0] is string
            && request.resource.data.photos[0].size() <= 170000
            && request.resource.data.photos[0].matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
          ||
          // Publicar el riesgo (misma transacción que notices).
          (
            resource.data.status == 'nuevo'
            && request.resource.data.status == 'publicado'
            && !('closure' in resource.data)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['status', 'alert'])
            && request.resource.data.alert is map
            && request.resource.data.alert.keys().hasOnly([
              'title', 'message', 'by', 'at'
            ])
            && request.resource.data.alert.keys().hasAll([
              'title', 'message', 'by', 'at'
            ])
            && request.resource.data.alert.title is string
            && request.resource.data.alert.title.size() >= 5
            && request.resource.data.alert.title.size() <= 120
            && request.resource.data.alert.message is string
            && request.resource.data.alert.message.size() >= 10
            && request.resource.data.alert.message.size() <= 600
            && request.resource.data.alert.by ==
              'Departamento de Protección Civil'
            && request.resource.data.alert.at is string
          )
          ||
          // Retirar una publicación después de controlar el riesgo.
          // El aviso se elimina en el mismo lote y el reporte se conserva.
          (
            resource.data.status == 'publicado'
            && 'closure' in resource.data
            && !('publicationRetired' in resource.data)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['publicationRetired'])
            && request.resource.data.publicationRetired == true
          )
          ||
          // Marcar controlado, conservando el reporte original.
          (
            request.resource.data.status == resource.data.status
            && !('closure' in resource.data)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['closure'])
            && request.resource.data.closure is map
            && request.resource.data.closure.keys().hasOnly([
              'note', 'at'
            ])
            && request.resource.data.closure.keys().hasAll([
              'note', 'at'
            ])
            && request.resource.data.closure.note is string
            && request.resource.data.closure.note.size() >= 10
            && request.resource.data.closure.note.size() <= 280
            && request.resource.data.closure.at is string
          )
        );

      // Solo puede eliminar borradores propios sin publicar.
      allow delete: if isCivilProtection()
        && resource.data.source == 'proteccion-civil'
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'nuevo'
        && !('closure' in resource.data);
    }

    // ==========================================
    // COLECCIÓN: NOTICES
    // AVISOS Y ALERTAS EN TIEMPO REAL
    // ==========================================

    match /notices/{id} {

      // Todos los usuarios con sesión iniciada
      // pueden consultar avisos.
      allow read: if signedIn();

      // Solamente Operaciones publica avisos.
      allow create: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'kind',
          'audience',
          'sectorId',
          'title',
          'message',
          'level',
          'reporter',
          'publishedBy',
          'reportId',
          'position',
          'creadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'kind',
          'audience',
          'sectorId',
          'title',
          'message',
          'level',
          'reporter',
          'publishedBy',
          'creadoEn'
        ])

        && validSectorId(
          request.resource.data.sectorId
        )

        && request.resource.data.audience in [
          'sector',
          'todos'
        ]

        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120

        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 600

        && request.resource.data.reporter is string
        && request.resource.data.reporter.size() <= 200

        && request.resource.data.publishedBy ==
          request.auth.uid

        && request.resource.data.creadoEn ==
          request.time;

      // ========================================
      // PROTECCIÓN CIVIL: ALERTAS GLOBALES
      // ========================================

      allow create: if isCivilProtection()
        && request.resource.data.keys().hasOnly([
          'kind', 'audience', 'sectorId', 'title', 'message',
          'level', 'reporter', 'publishedBy', 'reportId', 'position', 'creadoEn'
        ])
        && request.resource.data.keys().hasAll([
          'kind', 'audience', 'sectorId', 'title', 'message',
          'level', 'reporter', 'publishedBy', 'reportId', 'position', 'creadoEn'
        ])
        && request.resource.data.kind == 'alerta-proteccion-civil'
        && request.resource.data.audience == 'todos'
        && validSectorId(request.resource.data.sectorId)
        && request.resource.data.level in [
          'medio', 'alto', 'critico'
        ]
        && request.resource.data.reporter ==
          'Departamento de Protección Civil'
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 600
        && request.resource.data.reportId is string
        && validPoint(request.resource.data.position)
        && request.resource.data.creadoEn == request.time
        // En el lote, el reporte asociado queda publicado.
        && getAfter(
          /databases/$(database)/documents/systemReports/$(request.resource.data.reportId)
        ).data.source == 'proteccion-civil'
        && getAfter(
          /databases/$(database)/documents/systemReports/$(request.resource.data.reportId)
        ).data.status == 'publicado'
        && getAfter(
          /databases/$(database)/documents/systemReports/$(request.resource.data.reportId)
        ).data.createdBy == request.auth.uid
        // El punto publicado debe coincidir con el riesgo original.
        && getAfter(
          /databases/$(database)/documents/systemReports/$(request.resource.data.reportId)
        ).data.position == request.resource.data.position
        && getAfter(
          /databases/$(database)/documents/systemReports/$(request.resource.data.reportId)
        ).data.sectorId == request.resource.data.sectorId;

      // PC actualiza el aviso a controlado y, en avisos antiguos, enlaza
      // reportId cuando el título, mensaje, sector y autor coinciden.
      // Se requiere cierre registrado en systemReports, que puede ocurrir
      // en el mismo lote (getAfter).
      allow update: if isCivilProtection()
        && resource.data.kind == 'alerta-proteccion-civil'
        && resource.data.publishedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['estado', 'reportId'])
        && request.resource.data.reportId is string
        && (
          !('reportId' in resource.data)
          || resource.data.reportId == request.resource.data.reportId
        )
        && request.resource.data.estado == 'controlado'
        && linkedPcReport(request.resource.data.reportId, resource.data)
        && getAfter(
          /databases/$(database)/documents/systemReports/$(request.resource.data.reportId)
        ).data.closure is map;

      // Retiro de publicación: elimina el AVISO público, no el informe.
      // El mismo lote debe marcar publicationRetired en systemReports.
      allow delete: if isCivilProtection()
        && resource.data.kind == 'alerta-proteccion-civil'
        && resource.data.publishedBy == request.auth.uid
        && resource.data.estado == 'controlado'
        && resource.data.reportId is string
        && linkedPcReport(resource.data.reportId, resource.data)
        && getAfter(
          /databases/$(database)/documents/systemReports/$(resource.data.reportId)
        ).data.publicationRetired == true;
    }

    // ==========================================
    // COLECCIÓN: SECTORSTATUS
    // ESTADO EN VIVO DEL SECTOR
    // ==========================================

    match /sectorStatus/{id} {

      // Consultar estado de los sectores.
      allow read: if signedIn();

      // Solo Operaciones cambia el estado.
      allow create, update: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'sectorId',
          'state',
          'actualizadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'sectorId',
          'state',
          'actualizadoEn'
        ])

        && request.resource.data.sectorId == id

        && validSectorId(id)

        && request.resource.data.state in [
          'normal',
          'reparacion'
        ]

        && request.resource.data.actualizadoEn ==
          request.time;

      allow delete: if false;
    }

    // ==========================================
    // COLECCIÓN: PCUNITS
    // UNIDADES DE GUARDIA DE PROTECCIÓN CIVIL
    // ==========================================

    match /pcUnits/{id} {
      allow read: if isCivilProtection() || isAdmin();

      allow create, update: if isCivilProtection()
        && request.resource.data.keys().hasOnly([
          'name', 'leader', 'shift', 'status', 'sectorId'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'leader', 'shift', 'status', 'sectorId'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.leader is string
        && request.resource.data.leader.size() >= 2
        && request.resource.data.leader.size() <= 60
        && request.resource.data.shift in [
          'matutino', 'vespertino', 'nocturno'
        ]
        && request.resource.data.status in [
          'rondin', 'atendiendo', 'disponible', 'fuera'
        ]
        && validSectorId(request.resource.data.sectorId);

      allow delete: if isCivilProtection();
    }

    // ==========================================
    // SEGURIDAD GENERAL
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
