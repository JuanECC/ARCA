rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'lJ9W2QteobbETqMoPBonAFfzMgh1';
    }
    function validProfile(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'nombre', 'role', 'tipo', 'creadoEn'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'nombre', 'role', 'tipo', 'creadoEn'])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.creadoEn == request.time
        && ((request.resource.data.role == 'citizen' && request.resource.data.tipo == 'comun')
          || (request.resource.data.role in ['admin', 'water-operator', 'civil-protection'] && request.resource.data.tipo == 'fijo'));
    }
    function fixedRole(uid) {
      return (uid == 'lJ9W2QteobbETqMoPBonAFfzMgh1' && request.resource.data.role == 'admin')
        || (uid == 'WePWGhGitzWeggBe76Z8Av4o3yH3' && request.resource.data.role == 'water-operator')
        || (uid == '0MgDjIllJTWIgLPyKCjA7EQNBSw1' && request.resource.data.role == 'civil-protection');
    }
    match /usuarios/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && validProfile(uid)
        && (isAdmin() || (request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && (request.resource.data.role == 'citizen' || fixedRole(uid))));
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
