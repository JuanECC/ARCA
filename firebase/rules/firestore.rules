
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES DE SEGURIDAD
    // ==========================================

    function isAdmin() {
      return request.auth != null
        && request.auth.uid ==
          'lJ9W2QteobbETqMoPBonAFfzMgh1';
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'authEmail',
          'nombre',
          'usuario',
          'role',
          'tipo',
          'creadoEn',
          'operadorUid'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'authEmail',
          'nombre',
          'usuario',
          'role',
          'tipo',
          'creadoEn'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches(
          '[^ @]+@[^ @]+[.][^ @]+'
        )
        && request.resource.data.authEmail is string
        && request.resource.data.usuario is string
        && request.resource.data.usuario.size() >= 2
        && request.resource.data.usuario.size() <= 64
        && request.resource.data.usuario.matches(
          '[a-z0-9]+(-[a-z0-9]+)*'
        )
        && request.resource.data.authEmail ==
          request.resource.data.usuario +
          '@usuarios.arca.example.com'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.creadoEn == request.time
        && (
          request.resource.data.role != 'maintenance-crew'
          || request.resource.data.operadorUid ==
            'WePWGhGitzWeggBe76Z8Av4o3yH3'
        )
        && (
          (
            request.resource.data.role == 'citizen'
            && request.resource.data.tipo == 'comun'
          )
          || (
            request.resource.data.role in [
              'admin',
              'water-operator',
              'civil-protection',
              'maintenance-crew'
            ]
            && request.resource.data.tipo == 'fijo'
          )
        );
    }

    function fixedRole(uid) {
      return (
          uid == 'lJ9W2QteobbETqMoPBonAFfzMgh1'
          && request.resource.data.role == 'admin'
        )
        || (
          uid == 'WePWGhGitzWeggBe76Z8Av4o3yH3'
          && request.resource.data.role == 'water-operator'
        )
        || (
          uid == '0MgDjIllJTWIgLPyKCjA7EQNBSw1'
          && request.resource.data.role == 'civil-protection'
        )
        || (
          uid == '6K9PgDGfgrhjn6wWTXQgvMzA8BB2'
          && request.resource.data.role == 'maintenance-crew'
        );
    }

    // ==========================================
    // VALIDACIÓN: CONFIGURACIÓN CIUDADANA
    // ==========================================

    function validCitizenSettings() {
      let p = request.resource.data;

      return p.keys().hasOnly([
          'address',
          'zone',
          'zipCode',
          'phone',
          'receiveAlerts',
          'fotoBase64',
          'actualizadoEn'
        ])
        && p.keys().hasAll([
          'address',
          'zone',
          'zipCode',
          'phone',
          'receiveAlerts',
          'fotoBase64',
          'actualizadoEn'
        ])

        // Dirección.
        && p.address is string
        && p.address.size() >= 8
        && p.address.size() <= 180

        // Zona hidrográfica.
        && p.zone in [
          'centro',
          'norte',
          'sur',
          'poniente',
          'rural'
        ]

        // Código postal de cinco dígitos.
        && p.zipCode is string
        && p.zipCode.matches('[0-9]{5}')

        // Teléfono normalizado.
        && p.phone is string
        && p.phone.matches('[0-9]{10,13}')

        // Preferencia de alertas.
        && p.receiveAlerts is bool

        // Fotografía opcional en Base64 WebP.
        && (
          p.fotoBase64 == null
          || (
            p.fotoBase64 is string
            && p.fotoBase64.size() <= 170000
            && p.fotoBase64.matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
        )

        // Fecha generada por Firebase.
        && p.actualizadoEn == request.time;
    }

    // ==========================================
    // VERIFICACIÓN: PERFIL COMPLETO
    // ==========================================

    function configuredCitizen(uid) {
      return exists(
          /databases/$(database)/documents/usuarios/$(uid)
        )

        // La cuenta debe ser ciudadana.
        && get(
          /databases/$(database)/documents/usuarios/$(uid)
        ).data.role == 'citizen'

        // Debe existir el perfil ampliado.
        && exists(
          /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil
        )

        // Dirección registrada.
        && get(
          /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil
        ).data.address is string

        && get(
          /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil
        ).data.address.size() >= 8

        // Zona válida.
        && get(
          /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil
        ).data.zone in [
          'centro',
          'norte',
          'sur',
          'poniente',
          'rural'
        ]

        // Código postal.
        && get(
          /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil
        ).data.zipCode.matches('[0-9]{5}')

        // Teléfono.
        && get(
          /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil
        ).data.phone.matches('[0-9]{10,13}');
    }

    // ==========================================
    // COLECCIÓN: USUARIOS
    // ==========================================

    match /usuarios/{uid} {

      // Consultar el perfil principal.
      allow get: if request.auth != null
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      // Solo administración puede listar cuentas.
      allow list: if isAdmin();

      // Registro ciudadano y altas autorizadas.
      allow create: if request.auth != null
        && validProfile(uid)
        && (
          isAdmin()
          || (
            request.auth.uid == uid
            && request.resource.data.authEmail ==
              request.auth.token.email
            && (
              request.resource.data.role == 'citizen'
              || fixedRole(uid)
            )
          )
        );

      // Proteger roles e identidad.
      allow update: if false;
      allow delete: if false;

      // ========================================
      // SUBCOLECCIÓN: CONFIGURACION
      // DOCUMENTO: PERFIL
      // ========================================

      match /configuracion/{configId} {

        // Cada ciudadano consulta su configuración.
        allow get: if request.auth != null
          && request.auth.uid == uid
          && configId == 'perfil';

        // No permitir listar configuraciones.
        allow list: if false;

        // Guardar o actualizar el perfil propio.
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && configId == 'perfil'
          && get(
            /databases/$(database)/documents/usuarios/$(uid)
          ).data.role == 'citizen'
          && validCitizenSettings();

        // Impedir eliminar el perfil.
        allow delete: if false;
      }
    }

    // ==========================================
    // COLECCIÓN: REPORTES CIUDADANOS
    // ==========================================

    match /reportes/{reporteId} {

      // Cualquier usuario autenticado puede
      // consultar reportes y verlos en el mapa.
      allow read: if request.auth != null;

      // Crear reportes únicamente con perfil completo.
      allow create: if request.auth != null

        // Verificar configuración ciudadana.
        && configuredCitizen(request.auth.uid)

        // Campos permitidos.
        && request.resource.data.keys().hasOnly([
          'usuarioUid',
          'autorNombre',
          'titulo',
          'descripcion',
          'tipo',
          'ubicacion',
          'precisionMetros',
          'fotoBase64',
          'estado',
          'prioridad',
          'creadoEn'
        ])

        // Campos obligatorios.
        && request.resource.data.keys().hasAll([
          'usuarioUid',
          'autorNombre',
          'titulo',
          'descripcion',
          'tipo',
          'ubicacion',
          'precisionMetros',
          'fotoBase64',
          'estado',
          'prioridad',
          'creadoEn'
        ])

        // El reporte pertenece al usuario.
        && request.resource.data.usuarioUid ==
          request.auth.uid

        // Nombre real de la cuenta registrada.
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre ==
          get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.nombre

        // Título.
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 5
        && request.resource.data.titulo.size() <= 100

        // Descripción.
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 10
        && request.resource.data.descripcion.size() <= 1500

        // Categorías.
        && request.resource.data.tipo in [
          'inundacion',
          'encharcamiento',
          'fuga',
          'drenaje',
          'otro'
        ]

        // Ubicación.
        && request.resource.data.ubicacion is map

        && request.resource.data.ubicacion.keys().hasOnly([
          'lat',
          'lng'
        ])

        && request.resource.data.ubicacion.keys().hasAll([
          'lat',
          'lng'
        ])

        // Latitud válida.
        && request.resource.data.ubicacion.lat is number
        && request.resource.data.ubicacion.lat >= -90
        && request.resource.data.ubicacion.lat <= 90

        // Longitud válida.
        && request.resource.data.ubicacion.lng is number
        && request.resource.data.ubicacion.lng >= -180
        && request.resource.data.ubicacion.lng <= 180

        // Precisión de ubicación.
        && request.resource.data.precisionMetros is number
        && request.resource.data.precisionMetros >= 0

        // Foto del reporte opcional en Base64.
        && (
          request.resource.data.fotoBase64 == null
          || (
            request.resource.data.fotoBase64 is string
            && request.resource.data.fotoBase64.size()
              <= 170000
            && request.resource.data.fotoBase64.matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
        )

        // Estado inicial obligatorio.
        && request.resource.data.estado == 'pendiente'

        // Prioridad inicial.
        && request.resource.data.prioridad ==
          'sin-evaluar'

        // Fecha de creación.
        && request.resource.data.creadoEn ==
          request.time;

      // No permitir modificar o eliminar reportes
      // desde el navegador.
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // SEGURIDAD GENERAL
    // ==========================================

    // Bloquear colecciones no autorizadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
