
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES DE SEGURIDAD
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid ==
          'lJ9W2QteobbETqMoPBonAFfzMgh1';
    }

    function isWaterOperator() {
      return signedIn() && (
        isAdmin()
        || (
          request.auth.uid ==
            'WePWGhGitzWeggBe76Z8Av4o3yH3'
          && get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.role == 'water-operator'
        )
      );
    }

    function isCivilProtection() {
      return signedIn()
        && request.auth.uid ==
          '0MgDjIllJTWIgLPyKCjA7EQNBSw1'
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.role == 'civil-protection';
    }

    function isMaintenance() {
      return signedIn()
        && request.auth.uid ==
          '6K9PgDGfgrhjn6wWTXQgvMzA8BB2'
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.role == 'maintenance-crew';
    }

    function validPoint(p) {
      return p is map
        && p.keys().hasOnly(['lat', 'lng'])
        && p.keys().hasAll(['lat', 'lng'])
        && p.lat is number
        && p.lat >= -90
        && p.lat <= 90
        && p.lng is number
        && p.lng >= -180
        && p.lng <= 180;
    }

    function validSectorId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 100
        && exists(
          /databases/$(database)/documents/sectors/$(id)
        );
    }

    // ==========================================
    // VALIDACIÓN DE CUENTAS EXISTENTES
    // ==========================================

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'authEmail',
          'nombre',
          'usuario',
          'role',
          'tipo',
          'creadoEn',
          'operadorUid'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'authEmail',
          'nombre',
          'usuario',
          'role',
          'tipo',
          'creadoEn'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches(
          '[^ @]+@[^ @]+[.][^ @]+'
        )
        && request.resource.data.authEmail is string
        && request.resource.data.usuario is string
        && request.resource.data.usuario.size() >= 2
        && request.resource.data.usuario.size() <= 64
        && request.resource.data.usuario.matches(
          '[a-z0-9]+(-[a-z0-9]+)*'
        )
        && request.resource.data.authEmail ==
          request.resource.data.usuario +
          '@usuarios.arca.example.com'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.creadoEn == request.time
        && (
          request.resource.data.role != 'maintenance-crew'
          || request.resource.data.operadorUid ==
            'WePWGhGitzWeggBe76Z8Av4o3yH3'
        )
        && (
          (
            request.resource.data.role == 'citizen'
            && request.resource.data.tipo == 'comun'
          )
          || (
            request.resource.data.role in [
              'admin',
              'water-operator',
              'civil-protection',
              'maintenance-crew'
            ]
            && request.resource.data.tipo == 'fijo'
          )
        );
    }

    function fixedRole(uid) {
      return (
          uid == 'lJ9W2QteobbETqMoPBonAFfzMgh1'
          && request.resource.data.role == 'admin'
        )
        || (
          uid == 'WePWGhGitzWeggBe76Z8Av4o3yH3'
          && request.resource.data.role == 'water-operator'
        )
        || (
          uid == '0MgDjIllJTWIgLPyKCjA7EQNBSw1'
          && request.resource.data.role == 'civil-protection'
        )
        || (
          uid == '6K9PgDGfgrhjn6wWTXQgvMzA8BB2'
          && request.resource.data.role == 'maintenance-crew'
        );
    }

    // ==========================================
    // CONFIGURACIÓN DEL PERFIL CIUDADANO
    // ==========================================

    function validCitizenSettings() {
      let p = request.resource.data;

      return p.keys().hasOnly([
          'address',
          'zone',
          'zipCode',
          'phone',
          'receiveAlerts',
          'fotoBase64',
          'actualizadoEn',
          'sectorId'
        ])
        && p.keys().hasAll([
          'address',
          'zone',
          'zipCode',
          'phone',
          'receiveAlerts',
          'fotoBase64',
          'actualizadoEn',
          'sectorId'
        ])

        && p.address is string
        && p.address.size() >= 8
        && p.address.size() <= 180

        && p.zone in [
          'centro',
          'norte',
          'sur',
          'poniente',
          'rural'
        ]

        && p.zipCode is string
        && p.zipCode.matches('[0-9]{5}')

        && p.phone is string
        && p.phone.matches('[0-9]{10,13}')

        && p.receiveAlerts is bool

        // Sector de tandeo obligatorio.
        && p.sectorId is string
        && p.sectorId.size() >= 1
        && p.sectorId.size() <= 100

        // Solo sectores existentes y activos.
        && exists(
          /databases/$(database)/documents/sectors/$(p.sectorId)
        )
        && get(
          /databases/$(database)/documents/sectors/$(p.sectorId)
        ).data.active == true

        // Foto de perfil opcional.
        && (
          p.fotoBase64 == null
          || (
            p.fotoBase64 is string
            && p.fotoBase64.size() <= 170000
            && p.fotoBase64.matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
        )

        && p.actualizadoEn == request.time;
    }

    function configuredCitizen(uid) {
      let u = /databases/$(database)/documents/usuarios/$(uid);
      let p = /databases/$(database)/documents/usuarios/$(uid)/configuracion/perfil;

      return exists(u)
        && get(u).data.role == 'citizen'
        && exists(p)
        && get(p).data.address is string
        && get(p).data.address.size() >= 8
        && get(p).data.zone in [
          'centro',
          'norte',
          'sur',
          'poniente',
          'rural'
        ]
        && get(p).data.zipCode is string
        && get(p).data.zipCode.matches('[0-9]{5}')
        && get(p).data.phone is string
        && get(p).data.phone.matches('[0-9]{10,13}')
        && get(p).data.sectorId is string
        && get(p).data.sectorId.size() > 0;
    }

    // ==========================================
    // COLECCIÓN: USUARIOS
    // ==========================================

    match /usuarios/{uid} {

      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create: if signedIn()
        && validProfile(uid)
        && (
          isAdmin()
          || (
            request.auth.uid == uid
            && request.resource.data.authEmail ==
              request.auth.token.email
            && (
              request.resource.data.role == 'citizen'
              || fixedRole(uid)
            )
          )
        );

      allow update, delete: if false;

      // ========================================
      // SUBCOLECCIÓN: CONFIGURACIÓN
      // ========================================

      match /configuracion/{configId} {

        allow get: if signedIn()
          && request.auth.uid == uid
          && configId == 'perfil';

        allow list: if false;

        allow create, update: if signedIn()
          && request.auth.uid == uid
          && configId == 'perfil'
          && get(
            /databases/$(database)/documents/usuarios/$(uid)
          ).data.role == 'citizen'
          && validCitizenSettings();

        allow delete: if false;
      }
    }

    // ==========================================
    // COLECCIÓN: REPORTES CIUDADANOS
    // ==========================================

    match /reportes/{reporteId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && configuredCitizen(request.auth.uid)

        && request.resource.data.keys().hasOnly([
          'usuarioUid',
          'autorNombre',
          'titulo',
          'descripcion',
          'tipo',
          'ubicacion',
          'precisionMetros',
          'fotoBase64',
          'estado',
          'prioridad',
          'creadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'usuarioUid',
          'autorNombre',
          'titulo',
          'descripcion',
          'tipo',
          'ubicacion',
          'precisionMetros',
          'fotoBase64',
          'estado',
          'prioridad',
          'creadoEn'
        ])

        && request.resource.data.usuarioUid ==
          request.auth.uid

        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre ==
          get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.nombre

        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 5
        && request.resource.data.titulo.size() <= 100

        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 10
        && request.resource.data.descripcion.size() <= 1500

        && request.resource.data.tipo in [
          'inundacion',
          'encharcamiento',
          'fuga',
          'drenaje',
          'otro'
        ]

        && validPoint(request.resource.data.ubicacion)

        && request.resource.data.precisionMetros is number
        && request.resource.data.precisionMetros >= 0

        && (
          request.resource.data.fotoBase64 == null
          || (
            request.resource.data.fotoBase64 is string
            && request.resource.data.fotoBase64.size()
              <= 170000
            && request.resource.data.fotoBase64.matches(
              'data:image/webp;base64,[A-Za-z0-9+/=]+'
            )
          )
        )

        && request.resource.data.estado == 'pendiente'
        && request.resource.data.prioridad ==
          'sin-evaluar'
        && request.resource.data.creadoEn == request.time;

      allow update, delete: if false;
    }

    // ==========================================
    // COLECCIÓN: SECTORS
    // SECTORES DE ABASTECIMIENTO
    // ==========================================

    match /sectors/{id} {

      // Operaciones consulta todos los sectores.
      // Ciudadanía solo los sectores activos.
      allow get, list: if isWaterOperator()
        || (
          signedIn()
          && resource.data.active == true
        );

      // Crear sectores.
      allow create: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'name',
          'colonias',
          'active',
          'creadoEn',
          'actualizadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'name',
          'colonias',
          'active',
          'creadoEn',
          'actualizadoEn'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100

        && request.resource.data.colonias is string
        && request.resource.data.colonias.size() >= 3
        && request.resource.data.colonias.size() <= 500

        && request.resource.data.active == true

        && request.resource.data.creadoEn == request.time
        && request.resource.data.actualizadoEn ==
          request.time;

      // Editar nombre, colonias o activar/desactivar.
      allow update: if isWaterOperator()

        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'name',
          'colonias',
          'active',
          'actualizadoEn'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100

        && request.resource.data.colonias is string
        && request.resource.data.colonias.size() >= 3
        && request.resource.data.colonias.size() <= 500

        && request.resource.data.active is bool

        && request.resource.data.actualizadoEn ==
          request.time;

      // Los sectores nunca se eliminan.
      allow delete: if false;
    }

    // ==========================================
    // COLECCIÓN: SCHEDULE
    // CALENDARIO DE TANDEO
    // ==========================================

    match /schedule/{id} {

      // Lectura de programación.
      allow read: if isWaterOperator()
        || (
          signedIn()
          && validSectorId(resource.data.sectorId)
          && get(
            /databases/$(database)/documents/sectors/$(resource.data.sectorId)
          ).data.active == true
        );

      // Crear o editar días.
      allow create, update: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'sectorId',
          'fecha',
          'status',
          'from',
          'to',
          'note',
          'actualizadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'sectorId',
          'fecha',
          'status',
          'from',
          'to',
          'note',
          'actualizadoEn'
        ])

        && validSectorId(
          request.resource.data.sectorId
        )

        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches(
          '[0-9]{4}-[0-9]{2}-[0-9]{2}'
        )

        && id ==
          request.resource.data.sectorId + '_' +
          request.resource.data.fecha

        && request.resource.data.status in [
          'continuo',
          'parcial',
          'corte'
        ]

        && request.resource.data.from is string
        && request.resource.data.to is string

        && request.resource.data.note is string
        && request.resource.data.note.size() <= 400

        && request.resource.data.actualizadoEn ==
          request.time;

      // Operaciones puede retirar programación.
      allow delete: if isWaterOperator();
    }

    // ==========================================
    // COLECCIÓN: SYSTEMREPORTS
    // REPORTES DE OPERACIONES Y PROTECCIÓN CIVIL
    // ==========================================

    match /systemReports/{id} {

      allow read: if isWaterOperator()
        || isCivilProtection()
        || isMaintenance();

      // Crear reportes institucionales.
      allow create: if (
          isWaterOperator()
          || isCivilProtection()
        )

        && request.resource.data.keys().hasOnly([
          'source',
          'sectorId',
          'type',
          'colonia',
          'description',
          'position',
          'photos',
          'status',
          'reporter',
          'createdBy',
          'citizenUid',
          'citizenReportId',
          'creadoEn',
          'level'
        ])

        && request.resource.data.keys().hasAll([
          'source',
          'sectorId',
          'type',
          'colonia',
          'description',
          'position',
          'photos',
          'status',
          'reporter',
          'creadoEn'
        ])

        && request.resource.data.source in [
          'ciudadano',
          'operaciones',
          'proteccion-civil'
        ]

        && validSectorId(
          request.resource.data.sectorId
        )

        && request.resource.data.type is string

        && request.resource.data.colonia is string
        && request.resource.data.colonia.size() <= 100

        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1500

        && validPoint(
          request.resource.data.position
        )

        // Evidencia obligatoria.
        && request.resource.data.photos is list
        && request.resource.data.photos.size() == 1

        && request.resource.data.photos[0] is string
        && request.resource.data.photos[0].size()
          <= 170000

        && request.resource.data.photos[0].matches(
          'data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+'
        )

        && request.resource.data.reporter is string
        && request.resource.data.reporter.size() <= 200

        && request.resource.data.status == 'nuevo'

        && request.resource.data.creadoEn ==
          request.time

        // Protección Civil solo crea sus reportes.
        && (
          isWaterOperator()
          || (
            isCivilProtection()
            && request.resource.data.source ==
              'proteccion-civil'
          )
        );

      // Operaciones asigna o publica reportes.
      // Cuadrillas terminan trabajos asignados.
      allow update: if (

        (
          isWaterOperator()
          && (
            (
              resource.data.status == 'nuevo'
              && request.resource.data.status in [
                'asignado',
                'publicado'
              ]
            )
            || (
              resource.data.status == 'terminado'
              && request.resource.data.status ==
                'resuelto'
            )
          )

          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'status',
            'assignment',
            'notice'
          ])
        )

        || (

          isMaintenance()
          && resource.data.status == 'asignado'
          && request.resource.data.status == 'terminado'

          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'status',
            'workDone'
          ])
        )
      );

      allow delete: if false;
    }

    // ==========================================
    // COLECCIÓN: NOTICES
    // AVISOS Y ALERTAS EN TIEMPO REAL
    // ==========================================

    match /notices/{id} {

      // Todos los usuarios con sesión iniciada
      // pueden consultar avisos.
      allow read: if signedIn();

      // Solamente Operaciones publica avisos.
      allow create: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'kind',
          'audience',
          'sectorId',
          'title',
          'message',
          'level',
          'reporter',
          'publishedBy',
          'reportId',
          'position',
          'creadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'kind',
          'audience',
          'sectorId',
          'title',
          'message',
          'level',
          'reporter',
          'publishedBy',
          'creadoEn'
        ])

        && validSectorId(
          request.resource.data.sectorId
        )

        && request.resource.data.audience in [
          'sector',
          'todos'
        ]

        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120

        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 600

        && request.resource.data.reporter is string
        && request.resource.data.reporter.size() <= 200

        && request.resource.data.publishedBy ==
          request.auth.uid

        && request.resource.data.creadoEn ==
          request.time;

      allow update, delete: if false;
    }

    // ==========================================
    // COLECCIÓN: SECTORSTATUS
    // ESTADO EN VIVO DEL SECTOR
    // ==========================================

    match /sectorStatus/{id} {

      // Consultar estado de los sectores.
      allow read: if signedIn();

      // Solo Operaciones cambia el estado.
      allow create, update: if isWaterOperator()

        && request.resource.data.keys().hasOnly([
          'sectorId',
          'state',
          'actualizadoEn'
        ])

        && request.resource.data.keys().hasAll([
          'sectorId',
          'state',
          'actualizadoEn'
        ])

        && request.resource.data.sectorId == id

        && validSectorId(id)

        && request.resource.data.state in [
          'normal',
          'reparacion'
        ]

        && request.resource.data.actualizadoEn ==
          request.time;

      allow delete: if false;
    }

    // ==========================================
    // SEGURIDAD GENERAL
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
